{
	"name": "ingesting_from_sql_database",
	"properties": {
		"activities": [
			{
				"name": "dtabasetables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"table": "table_names",
							"schema": "dbo"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "dtabasetables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('dtabasetables').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "checking_for_new_data",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "select count(*) as newrows from @{item().name} \nwhere \nlast_updated_at > (\nselect last_updated_at from dbo.watermarkTable\nwhere tablename = '@{split(item().name,'.')[1]}_date')",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "checking_for_new_rows",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "checking_for_new_data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('checking_for_new_data').output.resultSets[0].rows[0].newrows,0)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copying data to datalake",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "select * from @{item().name} \nwhere last_updated_at > (\n    select last_updated_at from dbo.watermarkTable\n    where tablename = '@{split(item().name,'.')[1]}_date')",
													"type": "Expression"
												},
												"queryTimeout": "00:05:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "AzureSqlTable1",
												"type": "DatasetReference",
												"parameters": {
													"table": {
														"value": "@split(item().name,'.' )[1]",
														"type": "Expression"
													},
													"schema": {
														"value": "@split(item().name,'.' )[0]",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "dy_parq_fold",
												"type": "DatasetReference",
												"parameters": {
													"cont": "sqlsource",
													"fold": {
														"value": "@split(item().name,'.' )[1]",
														"type": "Expression"
													},
													"file": {
														"value": "@concat(split(item().name, '.')[1], '_', formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.parquet')\n\n\n\n",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Stored procedure1",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copying data to datalake",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[UpdateWatermark]",
											"storedProcedureParameters": {
												"LastModifiedTime": {
													"value": {
														"value": "@utcNow()",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"TableName": {
													"value": {
														"value": "@{split(item().name,'.' )[1]}_date",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "AzureSqlDatabase1",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}